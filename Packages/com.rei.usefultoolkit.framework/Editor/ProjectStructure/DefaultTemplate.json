{
    "version": 1,
    "description": "UsefulToolkit standard Assets layout. Rules are evaluated in the order ExactPath -> Folder -> Glob -> Name, and a target claimed by an earlier rule is never re-evaluated. 'excludes' blocks a path from being treated as a move source (and from snapshot scanning) but still allows it to be used as a destination. Unity's special folders are excluded so that their meaning is not broken by a move.",
    "excludes": [
        "Assets/LocalAssets",
        "Assets/Plugins",
        "Assets/Editor",
        "Assets/Editor Default Resources",
        "Assets/Gizmos",
        "Assets/Resources",
        "Assets/StreamingAssets",
        "Assets/Standard Assets"
    ],
    "folders": [
        "Assets/Art",
        "Assets/Audio",
        "Assets/Code",
        "Assets/Code/AutoGenerated",
        "Assets/Code/AutoGenerated/Editor",
        "Assets/Code/AutoGenerated/Runtime",
        "Assets/Code/Scripts",
        "Assets/Code/Scripts/Initialization",
        "Assets/Code/Scripts/Application",
        "Assets/Code/Scripts/BlackBoardLayer",
        "Assets/Code/Scripts/ExternalLayer",
        "Assets/Code/Scripts/EngineServiceLayer",
        "Assets/Data",
        "Assets/Data/Settings",
        "Assets/Docs",
        "Assets/Level",
        "Assets/Level/InputSystem",
        "Assets/Level/Scenes",
        "Assets/Plugins"
    ],
    "rules": [
        {
            "match": "ExactPath",
            "pattern": "Assets/Readme.asset",
            "action": "Delete",
            "destination": ""
        },
        {
            "match": "ExactPath",
            "pattern": "Assets/InputSystem_Actions.inputactions",
            "action": "Move",
            "destination": "Assets/Level/InputSystem"
        },
        {
            "match": "Folder",
            "pattern": "Assets/TutorialInfo",
            "action": "Delete",
            "destination": ""
        },
        {
            "match": "Folder",
            "pattern": "Assets/Settings",
            "action": "Move",
            "destination": "Assets/Data"
        },
        {
            "match": "Folder",
            "pattern": "Assets/Scenes",
            "action": "Move",
            "destination": "Assets/Level"
        },
        {
            "match": "Folder",
            "pattern": "Assets/TextMesh Pro",
            "action": "Move",
            "destination": "Assets/Plugins"
        },
        {
            "match": "Folder",
            "pattern": "Assets/Test",
            "action": "Move",
            "destination": "Assets/Code"
        },
        {
            "match": "Glob",
            "pattern": "Assets/*.unity",
            "action": "Move",
            "destination": "Assets/Level/Scenes"
        },
        {
            "match": "Glob",
            "pattern": "Assets/*.scenetemplate",
            "action": "Move",
            "destination": "Assets/Level/Scenes"
        },
        {
            "match": "Glob",
            "pattern": "Assets/*.inputactions",
            "action": "Move",
            "destination": "Assets/Level/InputSystem"
        },
        {
            "match": "Glob",
            "pattern": "Assets/*.asset",
            "action": "Move",
            "destination": "Assets/Data/Settings"
        }
    ]
}
